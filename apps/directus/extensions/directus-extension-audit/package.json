{
  "name": "directus-extension-audit",
  "version": "1.0.0",
  "description": "Records the two things Directus does not: reads of patient records, and failed sign-ins.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ahmad Khan <ahmad@khanahmad.com>",
  "type": "module",
  "icon": "policy",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0 || ^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@directus/errors": "2.5.1",
    "@directus/extensions-sdk": "13.1.1",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vue-tsc": "2.2.12"
  },
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@10.33.0"
}
