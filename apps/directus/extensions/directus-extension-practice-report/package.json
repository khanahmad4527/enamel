{
  "name": "directus-extension-practice-report",
  "version": "1.0.0",
  "description": "The numbers a practice owner runs the business on \u2014 the ratios an Insights panel cannot divide.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ahmad Khan <ahmad@khanahmad.com>",
  "type": "module",
  "icon": "insights",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "module",
        "name": "practice-report",
        "source": "src/module/index.ts"
      },
      {
        "type": "endpoint",
        "name": "practice-report-api",
        "source": "src/endpoint/index.ts"
      }
    ],
    "host": "^11.0.0 || ^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "13.1.1",
    "@enamel/extension-ui": "workspace:*",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vue": "3.5.42",
    "vue-tsc": "2.2.12"
  },
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@10.33.0"
}
