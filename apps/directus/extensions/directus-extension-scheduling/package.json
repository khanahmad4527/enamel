{
  "name": "directus-extension-scheduling",
  "version": "1.0.0",
  "description": "Turns scheduling conflicts into errors a human can act on, and derives appointment duration from the treatment being booked.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ahmad Khan <ahmad@khanahmad.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanahmad4527/enamel.git",
    "directory": "extensions/directus-extension-scheduling"
  },
  "homepage": "https://github.com/khanahmad4527/enamel#scheduling",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-hook",
    "dental",
    "scheduling"
  ],
  "type": "module",
  "icon": "event_busy",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0 || ^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@directus/errors": "2.5.1",
    "@directus/extensions-sdk": "13.1.1",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vue-tsc": "2.2.12"
  },
  "engines": {
    "node": ">=18.17"
  }
}
