# Debian, not Alpine.
#
# The site runs in workerd — the same runtime Cloudflare runs — and
# Cloudflare ships workerd as a glibc binary with no musl build. On
# node:22-alpine the container starts and then dies on a missing loader,
# which is a confusing way to learn that. The other images in this stack
# are Alpine; this one cannot be.
FROM node:22-slim AS build
WORKDIR /repo
RUN corepack enable

# Manifests first, so a dependency change invalidates the install layer
# rather than every edit to a route.
COPY pnpm-workspace.yaml pnpm-lock.yaml* package.json ./
COPY apps/public/package.json ./apps/public/
RUN pnpm install --filter @enamel/public... --frozen-lockfile || pnpm install --filter @enamel/public...

COPY apps/public ./apps/public
RUN pnpm --filter @enamel/public build

FROM node:22-slim
WORKDIR /repo
RUN corepack enable
ENV NODE_ENV=production

# The dev dependencies come along on purpose: wrangler is what serves the
# site here, and it runs the built worker in workerd — the same runtime
# Cloudflare runs. The container therefore runs the artefact that would be
# deployed, rather than a Node re-implementation of it.
COPY pnpm-workspace.yaml pnpm-lock.yaml* package.json ./
COPY apps/public/package.json ./apps/public/
RUN pnpm install --filter @enamel/public... --frozen-lockfile || pnpm install --filter @enamel/public...

# The build output, and nothing else. `dist/server/wrangler.json` is
# generated by the Cloudflare plugin and already points at the client
# assets beside it, so the runtime image needs no source and no config
# from the repository.
COPY --from=build /repo/apps/public/dist ./apps/public/dist
COPY apps/public/docker-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && chown -R node:node /repo/apps/public

USER node
WORKDIR /repo/apps/public
EXPOSE 8058
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
