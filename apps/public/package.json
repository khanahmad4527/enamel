    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.131.1",
    "@cloudflare/vite-plugin": "1.54.8"
  },
  "engines": {
    "node": ">=20"
  },
