{
  // The public website, as flat files on Cloudflare.
  //
  // `pnpm site:static` crawls the running site into ../dist-static and
  // this publishes that directory. There is no server here and no
  // Directus: signing in, booking and registering all need a backend,
  // so those links point at the repository instead.
  //
  // Run from this directory — wrangler refuses to guess a project at the
  // root of a pnpm workspace.
  //
  //   cd deploy && npx wrangler deploy
  "name": "enamel",
  // One address, and it is the custom domain. The workers.dev URL is off
  // so the site cannot be found at two names — which matters for a demo
  // that search engines will index.
  //
  // Order matters if this is ever rebuilt from scratch: turning
  // workers.dev off before the custom domain resolves leaves nothing
  // serving at all, which is exactly what happened here once.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../dist-static",
    // Every page is written as <path>/index.html, and this serves
    // /team/index.html at /team — the address the canonical, the sitemap
    // and every link use — with /team/ redirecting to it. The default,
    // auto-trailing-slash, does the opposite for folders: /team answered
    // 307 to /team/, so each canonical named a redirect.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The apex is Ahmad's portfolio and is deliberately untouched.
  //
  // `wrangler deploy` binds this route but cannot create the DNS record:
  // its OAuth token carries `zone:read` and no DNS write. The record was
  // made once through the Workers custom-domain API, which creates it as
  // a side effect of attaching the hostname and is covered by
  // `workers_routes:write`:
  //
  //   PUT /accounts/<account>/workers/domains
  //   { environment, hostname, service, zone_id }
  //
  // After that this line keeps the domain attached on every deploy.
  "routes": [
    { "pattern": "enamel.khanahmad.com", "custom_domain": true }
  ]
}
