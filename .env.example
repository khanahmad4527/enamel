# ---- Postgres ----------------------------------------------------------
DB_DATABASE=enamel
DB_USER=enamel
DB_PASSWORD=change-me-in-production
# Published on loopback only, for the provisioning step and the check
# suite — Directus and the core service reach the database over the
# compose network and ignore this. Move it if you already run Postgres,
# or another project's stack, on 5432; the symptom is compose refusing to
# start with "port is already allocated".
DB_PORT=9432

# Host port. 8055 is often taken by another Directus already.
DIRECTUS_PORT=9056

# ---- Directus ----------------------------------------------------------
# Generate fresh values: openssl rand -hex 32
SECRET=replace-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@enamel.dev
ADMIN_PASSWORD=change-me-in-production

# Both of these are derived from DIRECTUS_PORT. Set them only to point at
# an instance that is not the one this compose file starts.
# PUBLIC_URL=http://localhost:9056
# DIRECTUS_URL=http://localhost:9056

# Which Directus image to run.
#
# 12.x refuses custom rules on access policies unless the instance is
# licensed — and those rules are the whole subject of this project, so an
# unlicensed 12.x fails to provision. A free Open Innovation Grant key
# clears it (under $5M revenue and under 50 employees):
#   https://directus.com/docs/licensing/open-innovation-grant
#
# Set DIRECTUS_IMAGE=directus/directus:11 to run without any key.
DIRECTUS_IMAGE=directus/directus:12.3.1

# Directus 12 licence key. Setting it here is enough — the server
# activates it against Directus's licensing service on boot and stores the
# resulting token. Activation is silent: check `GET /license` for
# status "active" rather than the logs. A first attempt that fails leaves
# entitlements at core tier; recreating the container retries.
# A key allows a limited number of activations and a fresh database claims
# one on boot, so tear down with ./scripts/teardown.sh rather than
# `docker compose down -v` — the first hands the activation back, the
# second strands it and the server never finds out.
#
# Never commit a real key — keep it in your password manager.
DIRECTUS_LICENSE_KEY=

# Directus 12 asks every admin to name a project owner before it lets you
# work, and naming one accepts the MSCL-1.0-GPL terms on that person's
# behalf. That is yours to give, so it ships blank: fill it in and the
# modal never appears, or leave it and accept in the dialog.
PROJECT_OWNER_EMAIL=

# ---- Email (appointment reminders, invoices) ---------------------------
# Mail goes to the Mailpit container, which catches everything and shows
# it at http://localhost:8025 — so the reminder flow is something you can
# watch rather than take on trust. Point these at a real SMTP server when
# you want mail to leave the machine.
EMAIL_FROM=no-reply@enamel.dev
MAILPIT_PORT=8025
# EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# ---- The patient site ---------------------------------------------------
# React Router v7 in workerd, served by wrangler — the same runtime
# Cloudflare runs, so what works here works there.
PUBLIC_PORT=8058

# Signs the cookie that carries a patient's Directus access token. Left
# blank, ./scripts/setup.sh generates one; rotating it signs every patient
# out, which is the correct response to it leaking.
PORTAL_SESSION_SECRET=

# `1` behind TLS. A `secure` cookie is simply never sent over plain http,
# which presents as "signing in does nothing" rather than as an error.
# PORTAL_SECURE=0

# How many registrations one address may make, and over what window.
# Generous on purpose: the addresses this sees are shared — a family, an
# office, a hospital's wifi — and a tight limit locks out a waiting room
# rather than an attacker.
# PORTAL_REGISTER_LIMIT=20
# PORTAL_REGISTER_WINDOW_MINUTES=60

# ---- The core service ---------------------------------------------------
# Slot search, messaging and reports. Both tokens below are written by the
# seed and should not be filled in by hand; the webhook secret is
# generated by ./scripts/setup.sh.
CORE_PORT=8057

# Checked on the provider webhook that receives patient replies.
# Deliberately not the operator token: handing a messaging provider a
# credential that can also read the queue is one leak, not two.
MESSAGING_INBOUND_SECRET=

# Written by the seed. Leave them empty — they are service-account tokens
# and the seed is what creates the accounts.
#
# Three of them, and three because what a leaked credential can reach is
# the only thing standing behind it. REMINDER_TOKEN reads the diary to
# send reminders; PORTAL_TOKEN can create a login and nothing else;
# WEBSITE_TOKEN is read-only and sees published content — services,
# questions, opening hours, team profiles, retention periods — and is
# refused on every clinical collection, which the verify suite asserts.
REMINDER_TOKEN=
PORTAL_TOKEN=
WEBSITE_TOKEN=

# ---- Providers ----------------------------------------------------------
# Every integration is an adapter, and which adapter answers is decided
# here. `mock` is the honest default everywhere: nothing is sent, every id
# is visibly prefixed `mock:`, and the boot log says so out loud.
#
# THE ONE RULE: naming a real provider without its credentials does not
# fall back to the mock. The service refuses to start and names the
# variables it is missing. A practice that believes it is reminding
# patients and is not is worse than a practice with no reminders — and the
# `messages` rows would say "sent", because to a mock they were.
#
# A misspelt name is refused for the same reason: SMS_PROVIDER=twillio is a
# typo, not a request for the mock.

# Email is already real and needs nothing here — it speaks SMTP to Mailpit,
# which is a genuine mail server that never forwards. Point EMAIL_SMTP_HOST
# at a relay and it is production.

# SMS — Twilio Programmable Messaging.
# https://www.twilio.com/docs/messaging/api/message-resource
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+31201234567            # ...or a Messaging Service instead:
# TWILIO_MESSAGING_SERVICE_SID=MG...  # carries the sender pool and opt-outs
# TWILIO_API_BASE=https://api.ie1.twilio.com   # EU data residency
# TWILIO_STATUS_CALLBACK=https://.../api/messaging/inbound

# WhatsApp — Meta Cloud API.
# https://developers.facebook.com/docs/whatsapp/cloud-api/reference/messages
# Not a third SMS channel: a business may only OPEN a conversation with a
# template Meta has approved, per language. WHATSAPP_TEMPLATE is required
# because there is no sensible default — an unapproved name is a 132001.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_TOKEN=...
# WHATSAPP_TEMPLATE=appointment_reminder_v1
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_API_VERSION=v21.0          # pinned, never "latest"

# Cards — Stripe PaymentIntents.
# https://docs.stripe.com/api/payment_intents/create
# Cash and bank transfers are recorded by the desk adapter and never leave
# the building whatever this says.
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_API_BASE=http://localhost:12111   # stripe-mock, for testing

# Once set, GET /api/integrations/preflight (as an administrator) asks each
# provider the cheapest authenticated question it has and reports what came
# back. That is how you find out the variables took, rather than by sending
# a real reminder to a real patient.

# ---- The queue board ----------------------------------------------------
# Bull Board, at CORE_PUBLIC_URL/queues. Reachable only through a one-time
# link the Directus "Queues" module asks for with your own token — there is
# no second password and nothing to set here for it to work.
#
# Administrators only: one queue holds jobs for every practice and the
# payloads carry patients' names.
# QUEUE_BOARD_ENABLED=false            # remove the page entirely
# QUEUE_BOARD_SESSION_MINUTES=30       # not extended on use
# QUEUE_BOARD_SECURE=1                 # behind TLS. A `secure` cookie is
                                       # never sent over plain http, which
                                       # presents as "it signs me straight
                                       # out" rather than as a TLS problem.

# ---- Backups ------------------------------------------------------------
# Encrypts every archive ./scripts/backup.sh writes, and is the only way
# to read one back. Left blank, ./scripts/setup.sh generates one — put a
# copy somewhere that is not this machine, because a passphrase kept only
# beside the backups it protects is not a passphrase, it is a filename.
BACKUP_PASSPHRASE=

# Where they land, and how many to keep.
# BACKUP_DIR=backups
# BACKUP_KEEP=7

# ---- Demo ---------------------------------------------------------------
# Every seeded account uses this, and it is printed on the login screen.
# DEMO_PASSWORD=EnamelDemo!2026

# The practice brand colour (hex). Drives the Directus accent, the monogram,
# the login screen and the generated placeholder imagery.
BRAND_COLOUR=#1978bb
