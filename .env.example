# ---- Postgres ----------------------------------------------------------
DB_DATABASE=enamel
DB_USER=enamel
DB_PASSWORD=change-me-in-production

# Host port. 8055 is often taken by another Directus already.
DIRECTUS_PORT=8056

# ---- Directus ----------------------------------------------------------
# Generate fresh values: openssl rand -hex 32
SECRET=replace-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@enamel.dev
ADMIN_PASSWORD=change-me-in-production

# Both of these are derived from DIRECTUS_PORT. Set them only to point at
# an instance that is not the one this compose file starts.
# PUBLIC_URL=http://localhost:8056
# DIRECTUS_URL=http://localhost:8056

# Which Directus image to run.
#
# 12.x refuses custom rules on access policies unless the instance is
# licensed — and those rules are the whole subject of this project, so an
# unlicensed 12.x fails to provision. A free Open Innovation Grant key
# clears it (under $5M revenue and under 50 employees):
#   https://directus.com/docs/licensing/open-innovation-grant
#
# Set DIRECTUS_IMAGE=directus/directus:11 to run without any key.
DIRECTUS_IMAGE=directus/directus:12.3.1

# Directus 12 licence key. Setting it here is enough — the server
# activates it against Directus's licensing service on boot and stores the
# resulting token. Activation is silent: check `GET /license` for
# status "active" rather than the logs. A first attempt that fails leaves
# entitlements at core tier; recreating the container retries.
# A key allows a limited number of activations and a fresh database claims
# one on boot, so tear down with ./scripts/teardown.sh rather than
# `docker compose down -v` — the first hands the activation back, the
# second strands it and the server never finds out.
#
# Never commit a real key — keep it in your password manager.
DIRECTUS_LICENSE_KEY=

# Directus 12 asks every admin to name a project owner before it lets you
# work, and naming one accepts the MSCL-1.0-GPL terms on that person's
# behalf. That is yours to give, so it ships blank: fill it in and the
# modal never appears, or leave it and accept in the dialog.
PROJECT_OWNER_EMAIL=

# ---- Email (appointment reminders, invoices) ---------------------------
# Mail goes to the Mailpit container, which catches everything and shows
# it at http://localhost:8025 — so the reminder flow is something you can
# watch rather than take on trust. Point these at a real SMTP server when
# you want mail to leave the machine.
EMAIL_FROM=no-reply@enamel.dev
MAILPIT_PORT=8025
# EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# ---- Demo ---------------------------------------------------------------
# Every seeded account uses this, and it is printed on the login screen.
# DEMO_PASSWORD=EnamelDemo!2026
